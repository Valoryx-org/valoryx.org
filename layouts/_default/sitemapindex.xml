{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- /* site.Sites (not .Sites): the page-level .Sites method errors on Hugo < ~0.147
       ("can't evaluate field Sites in type []*hugolib.Site"); site.Sites resolves on every
       supported version. */ -}}
{{- range site.Sites }}
{{- with .Home.OutputFormats.Get "sitemap" }}
  <sitemap>
    <loc>{{ .Permalink }}</loc>
  </sitemap>
{{- end }}
{{- end }}
</sitemapindex>
